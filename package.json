{
  "name": "tfc-election2026",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run generate:og && tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir .server && node scripts/prerender.mjs",
    "preview": "node server.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "start": "node server.mjs",
    "generate:og": "node scripts/generate-og.mjs",
    "generate:pages": "npm run generate:og && node scripts/prerender.mjs",
    "test:production": "node --test tests/production.test.mjs",
    "test:e2e:production": "PLAYWRIGHT_TARGET=production playwright test"
  },
  "dependencies": {
    "@fontsource/noto-serif-tc": "^5.2.7",
    "@fontsource/source-serif-4": "^5.2.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
