{
  "name": "tfc-election2026",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run generate:og && tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir .server && node scripts/prerender.mjs",
    "build:worker": "PUBLIC_BASE_PATH=/election2026/ SITE_URL=https://tfc-taiwan.org.tw npm run build && node scripts/stage-worker.mjs",
    "preview:worker": "wrangler dev --local",
    "deploy:worker": "npm run build:worker && wrangler deploy",
    "preview": "node server.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "start": "node server.mjs",
    "generate:og": "node scripts/generate-og.mjs",
    "generate:pages": "npm run generate:og && node scripts/prerender.mjs",
    "test:production": "node --test tests/production.test.mjs",
    "test:e2e:production": "PLAYWRIGHT_TARGET=production playwright test",
    "data:import": "node --experimental-strip-types scripts/convert-spreadsheet.ts",
    "data:reports": "node --experimental-strip-types scripts/convert-reports.ts",
    "sheets:rows": "node --experimental-strip-types scripts/export-sheet-rows.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans-tc": "^5.3.0",
    "@fontsource/noto-serif-tc": "^5.2.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "read-excel-file": "^9.3.10",
    "sharp": "^0.35.4",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.136.2"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
